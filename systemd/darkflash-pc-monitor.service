[Unit]
Description=DarkFlash PC Monitor native telemetry display
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/darkflash-pc-monitor/service.env
ExecStart=/usr/bin/env ${DARKFLASH_PC_MONITOR} render
ExecStopPost=/usr/bin/env ${DARKFLASH_PC_MONITOR} blank
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
